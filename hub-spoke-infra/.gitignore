# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform cache and plugins
.terraform/
.terraform.lock.hcl

# Variable files with secrets — never commit these
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubeconfig exports
*.kube
kubeconfig*
