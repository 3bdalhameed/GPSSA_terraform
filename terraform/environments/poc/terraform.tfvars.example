prefix   = "gpssa"
project  = "gpssa-poc"
location = "uaenorth"

# Generate with: openssl rand -base64 32
vpn_shared_key = "CHANGE_ME_use_a_strong_random_key"

vm_admin_username = "azureuser"

# Paste the contents of your ~/.ssh/id_rsa.pub here
vm_ssh_public_key = "ssh-rsa AAAA..."

# Lock SSH access to your own IP — find it at https://ifconfig.me
gpssa_sim_ssh_source_ip = "x.x.x.x/32"
