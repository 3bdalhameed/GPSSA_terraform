prefix   = "gpssa"         # must match your shared environment prefix
location = "uaenorth"     # must match your shared environment

# Generate a strong key: openssl rand -base64 32
vpn_shared_key = "CHANGE_ME_strong_random_key"

vm_admin_username = "azureuser"

# Contents of ~/.ssh/id_rsa.pub
vm_ssh_public_key = "ssh-rsa AAAA..."

# Your public IP — find it with: curl ifconfig.me
ssh_source_ip = "x.x.x.x/32"

# GPSSA-sim network (defaults are fine for POC)
# gpssa_sim_vnet_cidr       = "192.168.0.0/16"
# gpssa_gateway_subnet_cidr = "192.168.0.0/27"
# gpssa_vm_subnet_cidr      = "192.168.1.0/24"
